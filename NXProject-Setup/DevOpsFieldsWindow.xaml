<Window x:Class="NXProject.Setup.DevOpsFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Setup_Step4Title}"
        Width="720" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Setup_Step4Desc}" FontSize="11.5" Foreground="#555"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <!-- A LISTA DE CAMPOS saiu daqui.
                 Ela existia identica na tela "Configurar Campos e Tags" do NXProject — duas telas
                 para a mesma configuracao, alimentadas pelo mesmo catalogo. Era so questao de
                 tempo ate divergirem, e ja aconteceu tres vezes com o catalogo de campos.
                 O instalador agora ENCAMINHA: o NXProject detecta, cria (pedindo o token de
                 administrador na hora, sem gravar), confere os niveis e exporta/importa o .json
                 com tudo — campos do DevOps, campos e tags do GitProject e o mapa de niveis. -->
            <Border Background="#F7F9FC" BorderBrush="#D0D7E0" BorderThickness="1" CornerRadius="6"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Setup_Step4OneScreen}" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="#2B579A" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Setup_Step4OneScreenBody}" FontSize="11.5"
                               Foreground="#444" TextWrapping="Wrap"/>
                    <Button x:Name="OpenNxBigButton" Content="{DynamicResource Setup_Step4OpenNxBig}"
                            HorizontalAlignment="Left" Height="34" Padding="18,0" Margin="0,14,0,0"
                            FontWeight="SemiBold" Click="OnOpenNxFieldsClick"
                            ToolTip="{DynamicResource Setup_Step4OpenNxTip}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Step4StatusText" FontSize="11" Foreground="#555" TextWrapping="Wrap"
                       Margin="0,12,0,0"/>

            <Button Content="{DynamicResource Setup_Close}" Width="110" Height="30"
                    HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="OnCloseClick"/>
        </StackPanel>
    </Border>
</Window>
