<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NXProject-Setup</AssemblyName>
    <RootNamespace>NXProject.Setup</RootNamespace>
    <ApplicationIcon>..\NXProject.Community\Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Acompanha a linha do produto: a 1.2 e a versao que traz o GitProject e o relatorio de
         niveis. O Setup e distribuido pelo timestamp (nxsetup-latest), nao pela tag, mas a
         versao e o que aparece no arquivo e no "Sobre" — e ver 1.1 num Setup da 1.2 confunde. -->
    <Version>1.2.0.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0.0</InformationalVersion>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NXProject.Community\Services\UpdateService.cs">
      <Link>Services\UpdateService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\AiCliInstaller.cs">
      <Link>Services\AiCliInstaller.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\NxDevOpsFieldCatalog.cs">
      <Link>Services\NxDevOpsFieldCatalog.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\NxLevelMap.cs">
      <Link>Services\NxLevelMap.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\DevOpsFieldSetupService.cs">
      <Link>Services\DevOpsFieldSetupService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\WindowsDataProtection.cs">
      <Link>Services\WindowsDataProtection.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
