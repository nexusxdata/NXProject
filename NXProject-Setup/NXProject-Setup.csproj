<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NXProject-Setup</AssemblyName>
    <RootNamespace>NXProject.Setup</RootNamespace>
    <ApplicationIcon>..\NXProject.Community\Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Version>1.1.0.10</Version>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NXProject.Community\Services\UpdateService.cs">
      <Link>Services\UpdateService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\AiCliInstaller.cs">
      <Link>Services\AiCliInstaller.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\NxDevOpsFieldCatalog.cs">
      <Link>Services\NxDevOpsFieldCatalog.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\DevOpsFieldSetupService.cs">
      <Link>Services\DevOpsFieldSetupService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\Services\WindowsDataProtection.cs">
      <Link>Services\WindowsDataProtection.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
