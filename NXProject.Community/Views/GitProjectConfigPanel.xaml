<UserControl x:Class="NXProject.Views.GitProjectConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        A conexão com o GitHub Projects como PAINEL, e não como janela: é o mesmo conteúdo de
        antes, agora numa aba da tela de conexões, ao lado do Azure DevOps. Eram duas janelas
        com o mesmo papel, abertas por dois itens de menu — e quem configurava precisava saber
        de antemão qual das duas procurar.
    -->
    <DockPanel>
        <!-- Liga/desliga a integracao inteira sem apagar o que esta configurado. -->
        <CheckBox DockPanel.Dock="Top" x:Name="EnabledBox" Margin="0,0,0,10"
                  Content="{DynamicResource Git_Enabled}"
                  ToolTip="{DynamicResource Git_EnabledTip}"
                  FontSize="11.5" FontWeight="SemiBold" Foreground="#2B579A"/>

        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Git_Intro}" FontSize="11.5"
                   Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Git_Owner}"
                       VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,6"/>
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                <CheckBox x:Name="IsOrgBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Margin="8,0,0,0" FontSize="11"
                          Content="{DynamicResource Git_IsOrg}"
                          ToolTip="{DynamicResource Git_IsOrgTip}"/>
                <TextBox x:Name="OwnerBox" Height="24" Padding="6,3"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Git_Token}"
                       VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,6"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TokenBox" Height="24" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Git_Board}"
                       VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,0"/>
            <DockPanel Grid.Row="2" Grid.Column="1">
                <Button x:Name="ListButton" DockPanel.Dock="Right" Content="{DynamicResource Git_List}"
                        Width="150" Height="24" Margin="8,0,0,0" Click="OnListClick"/>
                <ComboBox x:Name="BoardCombo" Height="24" FontSize="11.5"/>
            </DockPanel>

            <!-- No GitHub a issue nasce num REPOSITORIO; o board e so uma visao sobre issues
                 de varios. Sem isto o Sincronizar atualiza o que existe, mas nao cria. -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Git_Repo}"
                       VerticalAlignment="Center" FontSize="11.5" Margin="0,6,8,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="RepoBox" Height="24" Padding="6,3"
                     Margin="0,6,0,0" ToolTip="{DynamicResource Git_RepoTip}"/>

            <!-- A duvida "para que serve isto se esta em branco?" nasceu de a explicacao estar
                 so no tooltip: em branco o board funciona, e o campo so faz falta na hora de
                 CRIAR fora do board. A dica fica a vista. -->
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Git_RepoHint}"
                       FontSize="10.5" Foreground="#888" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </Grid>

        <!-- Link para gerar o token: a pessoa esta aqui justamente porque nao tem o token, e
             procurar a pagina no GitHub e o passo em que mais se erra. -->
        <TextBlock DockPanel.Dock="Top" FontSize="10.5" Foreground="#888"
                   TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="{DynamicResource Git_TokenHint}"/>
            <LineBreak/>
            <Hyperlink NavigateUri="https://github.com/settings/tokens"
                       RequestNavigate="OnHyperlinkRequestNavigate">
                <Run Text="{DynamicResource Git_TokenLink}"/>
            </Hyperlink>
        </TextBlock>

        <!-- Comeca FECHADO: quem ja tem o token nao precisa ler nada. Dentro, cada assunto tem
             subtitulo — antes eram quatro paragrafos corridos. -->
        <Expander DockPanel.Dock="Top" IsExpanded="False" Margin="0,0,0,10"
                  Header="{DynamicResource Git_PermTitle}" FontSize="11.5">
            <Border Background="#F7F9FC" BorderBrush="#D0D7E0" BorderThickness="1"
                    CornerRadius="4" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Git_PermSteps}" FontSize="11.5"
                               Foreground="#222" TextWrapping="Wrap" LineHeight="18"/>

                    <Separator Margin="0,10,0,8" Background="#DDE3EA"/>
                    <TextBlock Text="{DynamicResource Git_PermWhyTitle}" FontSize="11"
                               FontWeight="SemiBold" Foreground="#444"/>
                    <TextBlock Text="{DynamicResource Git_PermWhy}" FontSize="10.5"
                               Foreground="#666" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0"/>

                    <TextBlock Text="{DynamicResource Git_PermTrapsTitle}" FontSize="11"
                               FontWeight="SemiBold" Foreground="#A33" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource Git_PermTraps}" FontSize="10.5"
                               Foreground="#A33" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0"/>

                    <TextBlock Text="{DynamicResource Git_PermAltTitle}" FontSize="11"
                               FontWeight="SemiBold" Foreground="#444" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource Git_PermAlternatives}" FontSize="10.5"
                               Foreground="#666" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Expander>

        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,10"
                Content="{DynamicResource Git_Test}" Width="170" Height="30" Click="OnTestClick"/>

        <Border BorderBrush="#D0D7E0" BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" Foreground="#333"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
