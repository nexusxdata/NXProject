<Window x:Class="NXProject.Views.PortfolioTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PTgt_Title}"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource PTgt_Intro}" FontSize="11.5"
                   Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#C0392B" TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource PTgt_Cancel}" Width="110" Height="32"
                    Margin="8,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource PTgt_Save}" Width="150" Height="32"
                    Click="OnSaveClick" Background="#107C10" Foreground="White" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- Cabeçalho das colunas -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource PTgt_ColProject}" FontSize="10.5" Foreground="#888"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource PTgt_ColTarget}" FontSize="10.5" Foreground="#888"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource PTgt_ColFolder}" FontSize="10.5" Foreground="#888"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource PTgt_ColSync}" FontSize="10.5" Foreground="#888"/>
        </Grid>

        <Border BorderBrush="#D0D7E0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList" Margin="6"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
