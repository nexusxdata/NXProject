<Window x:Class="NXProject.Views.TfsSprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sprint_BoardTitle}"
        Height="680" Width="1180"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Seletor de visao: RadioButton exclusivo com template proprio. O template padrao do
             ToggleButton pinta o IsChecked de azul-claro por cima do Background, o que apagava o
             destaque; aqui a Border segue as cores do estilo e o ativo fica azul solido. -->
        <Style x:Key="ViewSegment" TargetType="RadioButton">
            <Setter Property="Background" Value="#F3F5F8"/>
            <Setter Property="BorderBrush" Value="#B8C2CE"/>
            <Setter Property="Foreground" Value="#2A3340"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E9F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B579A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F3F70"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Arvore do filtro: o Expander padrao do Windows desenha uma seta dentro de um
             circulo, que fica grande e desalinhada do checkbox. Aqui o "no" e so um
             chevron discreto (> quando fechado, v quando aberto), do tamanho do texto. -->
        <Style x:Key="FilterBranch" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton x:Name="Toggle" DockPanel.Dock="Left" Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="14" Height="14" Margin="0,0,2,0"
                                              VerticalAlignment="Center"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <!-- Fechado: chevron apontando para a direita.
                                                     Aberto: apontando para baixo (troca do Data;
                                                     um RotateTransform nomeado nao pode ser alvo
                                                     de Trigger dentro de ControlTemplate). -->
                                                <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8 Z"
                                                      Fill="#6B7480"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,5 Z"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="#2B579A"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Fill" Value="#2B579A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Ações (sempre visíveis, fora do wrap dos filtros) -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <Button x:Name="UpdateTfsButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                    Padding="10,3" Margin="8,0,0,0" IsEnabled="False" Click="OnUpdateTfsClick"
                    Background="#107C10" Foreground="White" FontWeight="SemiBold"
                    Content="{DynamicResource Sprint_UpdateTfs}"/>
            <Button x:Name="RevertButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                    Padding="8,3" Margin="8,0,0,0" IsEnabled="False" Click="OnRevertClick"
                    Content="{DynamicResource Sprint_Revert}"/>
            <Button x:Name="CloseButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                    Padding="8,3" Margin="8,0,0,0" Click="OnCloseClick"
                    Content="✖" ToolTip="{DynamicResource Sprint_Close}"/>
            <ProgressBar x:Name="SaveProgress" DockPanel.Dock="Right" Width="140" Height="14"
                         VerticalAlignment="Center" Margin="0,0,8,0" Minimum="0" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555" Margin="0,0,8,0"/>
        </DockPanel>
        <!-- Filtros (quebram linha se faltar espaço) -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Sprint_Pick}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ToggleButton x:Name="SprintFilterToggle" VerticalAlignment="Center" Padding="8,2" MinWidth="240"
                          Content="{DynamicResource Sprint_AllSprints}" ToolTip="{DynamicResource Sprint_MultiTip}"
                          Checked="OnSprintFilterOpened"/>
            <Popup PlacementTarget="{Binding ElementName=SprintFilterToggle}" Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=SprintFilterToggle}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#C9D3CC" BorderThickness="1" Padding="6">
                    <DockPanel MaxHeight="400" MinWidth="300">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Sprint_MultiHint}" TextWrapping="Wrap"
                                   Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource Sprint_AllSprints}" Click="OnSprintMultiNone" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sprint_StoryApply}" Click="OnSprintMultiApply" Padding="8,2"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <StackPanel x:Name="SprintMultiList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>
            <Button x:Name="CurrentSprintButton" VerticalAlignment="Center"
                    Padding="6,2" Margin="4,0,0,0" Click="OnCurrentSprintClick"
                    Content="📍" ToolTip="{DynamicResource Sprint_CurrentTip}"/>
            <Button x:Name="ReloadButton" VerticalAlignment="Center" Padding="6,2" Margin="4,0,0,0"
                    Click="OnReloadClick" Content="🔄" ToolTip="{DynamicResource Sprint_Reload}"/>
            <!-- Filtro de Projeto: logo depois da escolha da Sprint. -->
            <ToggleButton x:Name="StoryFilterToggle" DockPanel.Dock="Left" VerticalAlignment="Center"
                          Padding="8,2" Margin="0,0,14,0" Content="{DynamicResource Sprint_StoryFilter}"/>
            <Popup PlacementTarget="{Binding ElementName=StoryFilterToggle}" Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=StoryFilterToggle}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#C9D3CC" BorderThickness="1" Padding="6">
                    <DockPanel MaxHeight="380" MaxWidth="420">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource Sprint_StoryAll}" Click="OnStoryFilterAll" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sprint_StoryNone}" Click="OnStoryFilterNone" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sprint_StoryApply}" Click="OnStoryFilterApply" Padding="8,2"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel x:Name="StoryFilterList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Sprint_Person}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <ToggleButton x:Name="PersonFilterToggle" DockPanel.Dock="Left" VerticalAlignment="Center"
                          Padding="8,2" MinWidth="150" Content="{DynamicResource Sprint_PersonAll}"/>
            <Popup PlacementTarget="{Binding ElementName=PersonFilterToggle}" Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=PersonFilterToggle}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#C9D3CC" BorderThickness="1" Padding="6">
                    <DockPanel MaxHeight="380" MinWidth="220">
                        <!-- Busca dentro do proprio filtro: com time grande a lista nao cabe na tela. -->
                        <TextBox x:Name="PersonSearchBox" DockPanel.Dock="Top" Margin="0,0,0,4"
                                 TextChanged="OnPersonSearchChanged"
                                 ToolTip="{DynamicResource Sprint_PersonSearchTip}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource Sprint_StoryAll}" Click="OnPersonFilterNone" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sprint_StoryApply}" Click="OnPersonFilterApply" Padding="8,2"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel x:Name="PersonFilterList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Sprint_View}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <!-- Um botao abaixo do outro: ocupa a largura de um e cabe na altura da barra. -->
            <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                <RadioButton x:Name="ViewBoardBtn" GroupName="BoardView" Style="{StaticResource ViewSegment}"
                             Content="{DynamicResource Sprint_ViewBoard}" Checked="OnFilterChanged"/>
                <RadioButton x:Name="ViewPersonBtn" GroupName="BoardView" Style="{StaticResource ViewSegment}"
                             Content="{DynamicResource Sprint_ViewByPerson}" Checked="OnFilterChanged" Margin="0,-1,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Sprint_Search}" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="150" VerticalAlignment="Center"
                     TextChanged="OnSearchChanged"/>
            <ComboBox x:Name="SearchScopeCombo" DockPanel.Dock="Left" Width="90" VerticalAlignment="Center"
                      Margin="4,0,0,0" SelectionChanged="OnFilterChanged" ToolTip="{DynamicResource Sprint_SearchScopeTip}"/>
            <ToggleButton x:Name="StateFilterToggle" DockPanel.Dock="Left" VerticalAlignment="Center"
                          Padding="8,2" Margin="8,0,0,0" Content="{DynamicResource Sprint_StateFilter}"/>
            <Popup PlacementTarget="{Binding ElementName=StateFilterToggle}" Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=StateFilterToggle}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#C9D3CC" BorderThickness="1" Padding="6">
                    <DockPanel MaxHeight="300" MinWidth="160">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{DynamicResource Sprint_StoryAll}" Click="OnStateFilterAll" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sprint_StoryApply}" Click="OnStateFilterApply" Padding="8,2"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Sprint_ClosedDays}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="ClosedDaysBox" Width="46" Text="30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="StateFilterList"/>
                    </DockPanel>
                </Border>
            </Popup>
            <CheckBox x:Name="EditModeCheck" VerticalAlignment="Center"
                      Margin="14,0,0,0" Click="OnFilterChanged"
                      Content="{DynamicResource Sprint_EditMode}" ToolTip="{DynamicResource Sprint_EditModeTip}"/>
            <Button x:Name="ColorsButton" VerticalAlignment="Center" Padding="6,2" Margin="14,0,0,0"
                    Click="OnColorsClick" Content="🎨" ToolTip="{DynamicResource Sprint_Colors}"/>
            <ToggleButton x:Name="ConfigToggle" VerticalAlignment="Center" Padding="6,2" Margin="10,0,0,0"
                          Content="⚙" ToolTip="{DynamicResource Sprint_Config}"/>
            <Popup PlacementTarget="{Binding ElementName=ConfigToggle}" Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=ConfigToggle}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#C9D3CC" BorderThickness="1" Padding="10">
                    <StackPanel MinWidth="250">
                        <TextBlock Text="{DynamicResource Sprint_Config}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <!-- Recorte do que aparece no board -->
                        <TextBlock Text="{DynamicResource Sprint_GroupScope}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6B7A8A" Margin="0,0,0,2"/>
                        <CheckBox x:Name="OnlyScheduleCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyScheduleStory}"
                                  ToolTip="{DynamicResource Sprint_OnlyScheduleStoryTip}"/>

                        <Separator Margin="0,8,0,6"/>
                        <!-- Recortes por marcação (tag) da Task -->
                        <TextBlock Text="{DynamicResource Sprint_GroupTaskTags}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6B7A8A" Margin="0,0,0,2"/>
                        <CheckBox x:Name="OnlyBlockedCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyBlocked}"
                                  ToolTip="{DynamicResource Sprint_OnlyBlockedTip}"/>
                        <CheckBox x:Name="OnlyUnplannedCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyUnplanned}"
                                  ToolTip="{DynamicResource Sprint_OnlyUnplannedTip}"/>
                        <CheckBox x:Name="OnlyDoingCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyDoing}"
                                  ToolTip="{DynamicResource Sprint_OnlyDoingTip}"/>
                        <CheckBox x:Name="OnlyDoneActiveCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyDoneActive}"
                                  ToolTip="{DynamicResource Sprint_OnlyDoneActiveTip}"/>

                        <Separator Margin="0,8,0,6"/>
                        <!-- Recorte por ESTADO da Task (nao e tag: le o estado do DevOps) -->
                        <TextBlock Text="{DynamicResource Sprint_GroupTaskState}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6B7A8A" Margin="0,0,0,2"/>
                        <CheckBox x:Name="OnlyTaskActiveCheck" Click="OnFilterChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_OnlyTaskActive}"
                                  ToolTip="{DynamicResource Sprint_OnlyTaskActiveTip}"/>

                        <Separator Margin="0,8,0,6"/>
                        <!-- Limite de WIP: quantas Tasks em andamento cada PESSOA pode ter.
                             Só alerta (marca a tag WIP no card e no DevOps); não impede o arrasto. -->
                        <TextBlock Text="{DynamicResource Sprint_GroupWip}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6B7A8A" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="8,2,0,2">
                            <TextBlock Text="{DynamicResource Sprint_WipLimit}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WipLimitBox" Width="42" Margin="6,0,0,0"
                                     VerticalAlignment="Center" TextAlignment="Center"
                                     LostFocus="OnWipLimitChanged" KeyDown="OnWipLimitKeyDown"
                                     ToolTip="{DynamicResource Sprint_WipLimitTip}"/>
                        </StackPanel>

                        <Separator Margin="0,8,0,6"/>
                        <!-- Preferência da tela (não filtra nada) -->
                        <TextBlock Text="{DynamicResource Sprint_GroupPrefs}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6B7A8A" Margin="0,0,0,2"/>
                        <CheckBox x:Name="AutoOpenCheck" Click="OnAutoOpenChanged" Margin="8,2,0,2"
                                  Content="{DynamicResource Sprint_AutoOpen}"
                                  ToolTip="{DynamicResource Sprint_AutoOpenTip}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </WrapPanel>

        <!-- Resumo por estado (contagem) -->
        <Border DockPanel.Dock="Top" Background="#F3F6F4" BorderBrush="#D5DDD7" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource Sprint_Summary}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="FilterSummary" Foreground="#557" FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>
                <ItemsControl x:Name="SummaryHost"/>
            </StackPanel>
        </Border>

        <!-- Taskboard. O scroll HORIZONTAL e o de fora (rola cabecalho e cards juntos, sempre
             alinhados); o VERTICAL e o de dentro, so do conteudo — assim o cabecalho das colunas
             fica fixo ao rolar a lista. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel>
                <StackPanel x:Name="HeaderHost" DockPanel.Dock="Top" Background="White"/>
                <ScrollViewer x:Name="BoardScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BoardHost"/>
                </ScrollViewer>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
