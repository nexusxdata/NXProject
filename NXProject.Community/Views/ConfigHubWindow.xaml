<Window x:Class="NXProject.Views.ConfigHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Hub_Title}"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <!--
        O mesmo bloco "Conexão e calendário" que já existe na tela de importação, agora também
        no menu Exibir. É um ÍNDICE: cada botão abre a tela que já faz o trabalho — nada é
        configurado aqui. Serve para quem vai preparar a integração não precisar lembrar em que
        menu está cada parte.
    -->
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Hub_Title}" FontSize="17" FontWeight="SemiBold"
                       Foreground="#2B579A"/>
            <TextBlock Text="{DynamicResource Hub_Subtitle}" FontSize="11.5" Foreground="#666"
                       TextWrapping="Wrap" Margin="0,4,0,14"/>

            <Border Background="#F8FBFF" BorderBrush="#CCD9EA" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Imp_ConfigConnectionTitle}"
                               FontWeight="SemiBold" FontSize="13" Foreground="#333" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <!-- Um botao so: os dois abriam a MESMA tela, mudando apenas a aba
                             inicial — e duas portas para a mesma sala so fazem perguntar qual
                             delas e a certa. -->
                        <Button Content="{DynamicResource Imp_ConfigConn}" Padding="10,4" FontSize="11"
                                MinWidth="175" Margin="0,0,8,8" Click="OnDevOpsClick"
                                ToolTip="{DynamicResource Imp_ConfigConnTip}"/>
                        <Button Content="{DynamicResource Imp_ConfigFields}" Padding="10,4" FontSize="11"
                                MinWidth="175" Margin="0,0,8,8" Click="OnFieldsClick"
                                ToolTip="{DynamicResource Imp_ConfigFieldsTip}"/>
                        <Button Content="{DynamicResource Imp_Calendar}" Padding="10,4" FontSize="11"
                                MinWidth="175" Margin="0,0,8,8" Click="OnCalendarClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Hub_Note}" FontSize="10.5" Foreground="#888"
                       TextWrapping="Wrap" Margin="2,10,0,0"/>

            <!-- Hub_Close, e nao Setup_Close: aquela chave e do instalador e nao existe aqui —
                 o botao aparecia cinza e sem texto. -->
            <Button Content="{DynamicResource Hub_Close}" HorizontalAlignment="Right"
                    Width="110" Height="30" Margin="0,16,0,0" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
