<Window x:Class="NXProject.Views.DevOpsProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PortEdit_Title}"
        Width="460" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource PortEdit_Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Height="28" Padding="6,4" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource PortEdit_Id}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="IdBox" Height="28" Padding="6,4" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource PortEdit_Process}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="ProcessBox" Height="28" Padding="6,4" Margin="0,0,0,12"
                     IsReadOnly="True" Background="#F3F5F8" Foreground="#555"
                     ToolTip="{DynamicResource PortEdit_ProcessTip}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource PortEdit_Type}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeBox" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource PortEdit_CostCenter}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="CcBox" Height="28" Padding="6,4"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource PortEdit_AdmGroup}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="AdmGroupBox" Height="28" Padding="6,4" Margin="0,0,0,4"
                     IsReadOnly="True" Background="#F3F5F8" Foreground="#555"
                     ToolTip="{DynamicResource PortEdit_AdmGroupTip}"/>
            <TextBlock Text="{DynamicResource PortEdit_AdmGroupHint}" FontSize="10.5"
                       Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <CheckBox x:Name="LoadTasksOnImportBox"
                      Content="{DynamicResource PortEdit_LoadTasksOnImport}"
                      FontWeight="SemiBold"
                      Margin="0,0,0,12"
                      ToolTip="{DynamicResource PortEdit_LoadTasksOnImportTip}"/>

            <!-- Origem do projeto. Fica aqui, junto do resto do cadastro, porque e do PROJETO:
                 e dela que o TaskBoard, o Importar e o Sincronizar nascem. O valor NAO vai para a
                 lista de projetos (que pode ser compartilhada em rede) e sim para a configuracao
                 local — a pasta de artefatos e um caminho da maquina de quem usa. -->
            <Separator Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource PortEdit_Backend}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="BackendBox" Height="28" Margin="0,0,0,4"
                      SelectionChanged="OnBackendChanged"
                      ToolTip="{DynamicResource PortEdit_BackendTip}"/>
            <TextBlock x:Name="BackendHint" Text="{DynamicResource PortEdit_BackendHint}" FontSize="10.5"
                       Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="FolderLabel" Text="{DynamicResource PortEdit_LocalFolder}"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="FolderBrowse" DockPanel.Dock="Right" Content="…" Width="30" Height="28"
                        Margin="6,0,0,0" Click="OnPickFolderClick"/>
                <TextBox x:Name="FolderBox" Height="28" Padding="6,4"/>
            </DockPanel>
            <TextBlock x:Name="FolderHint" Text="{DynamicResource PortEdit_LocalFolderHint}" FontSize="10.5"
                       Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="{DynamicResource PortEdit_Ok}" Width="90" Height="30" IsDefault="True" Click="OnOkClick"/>
                <Button Content="{DynamicResource PortEdit_Cancel}" Width="90" Height="30" Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
