<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pacote compartilhado (NXPilot e NXProject): instala e localiza os agentes de IA no Windows
    (Claude Code e Codex CLI). Dois modos: INTERNO (o próprio .NET baixa, confere o SHA-256 e
    instala — sem script, para antivírus que bloqueiam PowerShell) e SCRIPT (instalador oficial
    numa janela visível). Versão: a última ou a testada, com queda para a última se a testada
    sumir. Sem dependências.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>NX.AgentInstaller</PackageId>
    <Authors>Nexus XData Tecnologia Ltda</Authors>
    <PackageDescription>Instala e localiza Claude Code e Codex CLI no Windows (modo interno sem script ou script oficial), última versão ou versão testada.</PackageDescription>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
